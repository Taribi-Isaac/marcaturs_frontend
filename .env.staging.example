# Staging build-time env (ENG-040A). Copy to .env.staging for `vite build --mode staging`.
# Never commit real secrets. Reverb key is public client key only.

VITE_API_BASE_URL=https://api.staging.example.com/api/v1
VITE_BACKEND_ORIGIN=https://api.staging.example.com
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=ws.staging.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
