# Production build-time env (MH-OPS-006). Every VITE_* value is PUBLIC — it is
# compiled into the browser bundle. Never put secrets here.
# CI reads these from the GitHub Environment "production" (variables, not secrets).
# Do not copy this to `.env.production` locally: `npm run build` would pick it up.

VITE_API_BASE_URL=https://api.marcaturshub.com.ng/api/v1
VITE_BACKEND_ORIGIN=https://api.marcaturshub.com.ng
# Canonical public origin (no trailing slash).
VITE_PUBLIC_ORIGIN=https://app.marcaturshub.com.ng
# Public Admin Control origin. Must equal backend ADMIN_FRONTEND_URL. Not a secret.
VITE_ADMIN_FRONTEND_URL=https://admin.marcaturshub.com.ng
# Public Reverb app key — must equal backend REVERB_APP_KEY (generated at provisioning).
# Never REVERB_APP_SECRET: every VITE_* value ships to browsers.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=ws.marcaturshub.com.ng
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# Optional overrides for the Product-confirmed social profiles compiled from
# src/app/config/socialLinks.ts. Leave unset unless a release must replace one.
# The production workflow does not forward these variables today.
# VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/marcaturshub
# VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/marcaturshub
# VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/marcaturshub
# VITE_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@marcaturshub
# VITE_SOCIAL_X_URL=https://x.com/MarcatursHub
# VITE_SOCIAL_YOUTUBE_URL=https://www.youtube.com/channel/UCfY4uW6OeOoZNMF1TOkaTBw
