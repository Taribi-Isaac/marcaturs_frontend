VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=http://localhost:8000
# Public site origin for canonical / Open Graph URLs (MH-FE-023). Optional locally —
# the SPA falls back to window.location.origin. Set explicitly for staging/production builds.
# VITE_PUBLIC_ORIGIN=https://app.example.com
# Local Reverb (matches backend REVERB_* placeholders). Optional — REST chat works without these.
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Optional overrides for the Product-confirmed social profiles in
# src/app/config/socialLinks.ts. Leave unset for local development.
# VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/marcaturshub
# VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/marcaturshub
# VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/marcaturshub
# VITE_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@marcaturshub
# VITE_SOCIAL_X_URL=https://x.com/MarcatursHub
